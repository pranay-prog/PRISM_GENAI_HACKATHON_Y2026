  "\\bprevious answer\\b",
  "\\bthat answer\\b",
  "\\bsame answer\\b",
  "\\bthe answer\\b",
  "\\bthat\\b",
  "\\bit\\b",
  "\\bthis\\b"
 ],
 "facts": [
  {
   "key": "issue",
   "value": "internet_down",
   "patterns": [
    "\\binternet (is |was )?(not|isn'?t|is not) working\\b",
    "\\bno internet\\b",
    "\\binternet (is )?down\\b",
    "\\bcan'?t get online\\b",
    "\\binternet stopped\\b"
   ]
  },
  {
   "key": "router_signal",
   "value": "red_los",
   "patterns": [
    "\\blos\\b",
    "\\bloss of signal\\b"
   ]
  },
  {
   "key": "router_signal",
   "value": "red_light",
   "patterns": [
    "\\bred light\\b(?!.*\\blos\\b)"
   ]
  },
  {
   "key": "device",
   "value": "phone",
   "patterns": [
    "\\bphone\\b",
    "\\bmobile\\b(?! data)"
   ]
  },
  {
   "key": "device",
   "value": "laptop",
   "patterns": [
    "\\blaptop\\b",
    "\\bcomputer\\b"
   ]
  },
  {
   "key": "failure_scope",
   "value": "all_devices",
   "patterns": [
    "\\b(phone|laptop|tablet|tv|computer) (also|too) (can'?t|cannot|won'?t|doesn'?t) connect",
    "\\balso (can'?t|cannot) connect\\b",
    "\\bnothing (can )?connects?\\b",
    "\\ball (my |the )?devices\\b"
   ]
  },
  {
   "key": "failure_scope",
   "value": "wifi_only",
   "patterns": [
    "\\bonly (the )?wi-?fi\\b",
    "\\bjust (the )?wi-?fi\\b",
    "\\bwi-?fi only\\b"
   ]
  },
  {
   "key": "mobile_data_working",
   "value": true,
   "patterns": [
    "\\bmobile data (works|is working|working|is fine|is ok)\\b",
    "\\b4g works\\b",
    "\\b5g works\\b"
   ]
  },
  {
   "key": "wifi_affected",
   "value": true,
   "patterns": [
    "\\bwi-?fi (doesn'?t|isn'?t|is not|does not|won'?t|not)\\b",
    "\\bconnect to (the )?wi-?fi\\b",
    "\\bonly (the )?wi-?fi\\b"
   ]
  },
  {
   "key": "location",
   "value": "home",
   "patterns": [
    "\\b(at|from) home\\b",
    "\\bhome network\\b"
   ]
  },
  {
   "key": "work_context",
   "value": "remote_work",
   "patterns": [
    "\\bwork(ing)? from home\\b",
    "\\bwfh\\b",
    "\\bremote(ly)? work"
   ]
  },
  {
   "key": "vpn_status",
   "value": "connected",
   "patterns": [
    "\\bvpn (is |shows )?connected\\b",
    "\\bconnected to (the )?vpn\\b"
   ]
  },
  {
   "key": "auth_error",
   "value": "mfa_error",
   "patterns": [
    "\\bmfa\\b",
    "\\b2fa\\b",
    "\\bverification code\\b",
    "\\bauthenticator\\b"
   ]
  },
  {
   "key": "target_resource",
   "value": "company_dashboard",
   "patterns": [
    "\\bcompany dashboard\\b",
    "\\binternal dashboard\\b"
   ]
  },
  {
   "key": "target_resource",
   "value": "finance_dashboard",
   "patterns": [
    "\\bfinance dashboard\\b",
    "\\bfinance (app|system|reports?)\\b"
   ]
  },
  {
   "key": "speed_issue",
   "value": "slow",
