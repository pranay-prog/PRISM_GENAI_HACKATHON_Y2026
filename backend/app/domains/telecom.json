  "\\bactually\\b",
  "\\bturns out\\b",
  "\\bi mean\\b",
  "\\bcorrection\\b",
  "\\bnot \\w+ but\\b",
  "\\bwait,?\\b",
  "\\bsorry,?\\b"
 ],
 "presentation_patterns": [
  "\\bsummari[sz]e\\b",
  "\\bsummary\\b",
  "\\bshorter\\b",
  "\\bshorten\\b",
  "\\bcondense\\b",
  "\\bbullet",
  "\\bin (one|two|three|four|five|\\d+) (points|sentences|lines)\\b",
  "\\bsimpler\\b",
  "\\bmore simply\\b",
  "\\bin simple (terms|words)\\b",
  "\\brephrase\\b",
  "\\breword\\b",
  "\\breformat\\b",
  "\\btl;?dr\\b"
 ],
