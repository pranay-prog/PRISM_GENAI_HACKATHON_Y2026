# ---- LLM (optional). Without one, the app uses deterministic extractive generation.
# ollama | openai | fallback  (an unreachable provider falls back automatically)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=20
# Let the LLM propose intents too (deterministic decomposition is the default)
LLM_DECOMPOSITION=false

# ---- Models (downloaded at image build time)
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=BAAI/bge-reranker-base
# lighter alternative: RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# auto | sentence_transformers | lsa
EMBEDDING_BACKEND=auto
# auto | cross_encoder | lexical | none
RERANKER_BACKEND=auto
PRELOAD_MODELS=true

# ---- Retrieval controller
RETRIEVAL_THRESHOLD=0.70
MONITOR_THRESHOLD=0.45
REDUNDANCY_THRESHOLD=0.92
# adaptive | every_chunk (ablation)
CONTROLLER_MODE=adaptive
# targeted | restart (ablation)
REFINEMENT_MODE=targeted

# ---- Retrieval
# hybrid | dense | bm25
RETRIEVAL_MODE=hybrid
TOP_K_PER_RETRIEVER=8
TOP_K_FINAL=5
RRF_K=60
GROUNDING_MIN_COVERAGE=0.34

# ---- Frontend (URL the BROWSER uses to reach the backend)
VITE_API_URL=http://localhost:8000
